{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-fork-web.ts",
  "installCommand": "corepack pnpm install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "omp-production": true
    }
  },
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/__build/:deployment(t3code-[a-z0-9-]+-sinchan-dasguptas-projects)/:path*",
      "destination": "https://:deployment.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fork-build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
